# =====================================================================
#  Motivate - configuracion unica (reemplaza docker-compose.yml + orientador.env)
#  Ubicacion: ~/.config/motivate/motivate.env   (permisos 600)
#  NO compartas este archivo: contiene claves de API.
#  Tras guardar cambios, reinicia los servicios desde la app.
# =====================================================================

# --- Motivate (app de escritorio) ---
# Puerto de la web principal (se escucha en 0.0.0.0)
MOTIVATE_PORT=7878
# Servicios que arrancan con "Iniciar todo": web, orientador, fabiola
MOTIVATE_SERVICIOS=web,orientador,fabiola
# Iniciar los servicios automaticamente al abrir la app (1 = si)
MOTIVATE_AUTOSTART=1
# Tunel ngrok (requiere el binario ngrok y NGROK_AUTHTOKEN)
NGROK_ENABLED=0
# Puertos internos de salud de los agentes (antes 8081 en Docker)
FABIOLA_HTTP_PORT=8081
ORIENTADOR_HTTP_PORT=8082

# --- LiveKit Cloud ---
LIVEKIT_URL=wss://ccs-gj2lkygb.livekit.cloud
LIVEKIT_API_KEY=APImbr2mUiBCxya
LIVEKIT_API_SECRET="Colocar API aqui"
AGENT_NAME=fabiola
ORIENTADOR_AGENT_NAME=orientador

# --- Proveedores de IA (STT -> LLM -> TTS) ---
SONIOX_API_KEY="Colocar API aqui"
CEREBRAS_API_KEY="Colocar API aqui"
CEREBRAS_MODEL=gpt-oss-120b
FISH_AUDIO_API_KEY="Colocar API aqui"

# =====================================================================
#  Variables del orientador (copiadas de orientador.env)
# =====================================================================
# --- Microsoft Graph (Teams + correo al psicólogo) ---
# Opción A (pruebas): token delegado de Graph Explorer. Debe tener Calendars.ReadWrite y Mail.Send. Caduca.
GRAPH_ACCESS_TOKEN="Colocar tocken aqui"
# Opción B (producción): registro de aplicación con permisos de aplicación Calendars.ReadWrite y Mail.Send.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_USER=

# A quién llegan las citas y el contexto de cada entrevista
PSICOLOGO_EMAIL=ksrodriguez@uth.hn
PSICOLOGO_NOMBRE=Psicología / Orientación

# Panel del psicólogo: http://localhost:7878/panel  (usuario: panel)
PANEL_PASSWORD=VxBjfRhn5G2-

# Secreto entre el agente y la web (no se usa desde el navegador)
INTERNAL_TOKEN=b9387edb2111c51fa3a5989789b190fb70b266e0862ce2d2

# Opcional: clave de YouTube Data API v3 para elegir el video de cada carrera automáticamente
YOUTUBE_API_KEY=

# Opcional: URL pública (la de ngrok) para poner enlaces al panel en los correos
PUBLIC_BASE_URL=

# Opcional: tunel ngrok (activa NGROK_ENABLED=1 arriba)
NGROK_AUTHTOKEN=

# Correos por Resend: todos los correos del orientador van a CORREOS_DESTINO
RESEND_API_KEY="Colocar API aqui"
RESEND_FROM=Orienta <onboarding@resend.dev>
CORREOS_DESTINO=lowfrax1@gmail.com
# Opcional: Gmail por SMTP para enviar a cualquier dirección (p. ej. lowfrax2@gmail.com).
# Requiere una CONTRASEÑA DE APLICACIÓN de Google (myaccount.google.com/apppasswords), no la contraseña normal.
# Al llenarlo tiene prioridad sobre Resend. Luego cambia CORREOS_DESTINO y reinicia el servicio web desde la app
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=lowfrax1@gmail.com
#SMTP_PASSWORD=xxxx xxxx xxxx xxxx
